# ==============================================================================
# VOXREADY - PLANTILLA MAESTRA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Este archivo sirve de referencia para desplegar y configurar los microservicios
# de la plataforma VoxReady.
#
# ESTRUCTURA DE ARCHIVOS POR SERVICIO:
#   1. Backend API (FastAPI)     -> backend/.env
#   2. Worker de Análisis (Python)-> worker/.env
#   3. Frontend Web (Next.js)    -> frontend/.env.local
#   4. Lab de Pruebas (Opcional) -> lab-worker/.env
#
# Para autogenerar los archivos con las credenciales de Azure, ejecuta:
#   PowerShell: ./scripts/sync-env.ps1
#   Bash:       ./scripts/sync-env.sh
# ==============================================================================


# ==============================================================================
# 1. BACKEND API (backend/.env)
# ==============================================================================
# Cadena de conexión a Azure SQL Database (tabla de usuarios, rúbricas y sesiones)
SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:sql-voxready-st.database.windows.net,1433;Database=sqldb-voxready;Uid=<db_user>;Pwd=<db_password>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"

# Cadena de conexión a Azure Blob Storage para generar URLs firmadas (SAS)
STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<storage_account_name>;AccountKey=<storage_key>;EndpointSuffix=core.windows.net"
STORAGE_CONTAINER_NAME="recordings"

# Cadena de conexión a Azure Service Bus para encolar grabaciones finalizadas
SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://<servicebus_namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<key>"
SERVICE_BUS_QUEUE_NAME="analysis-queue"

# Bypass de autenticación para entornos de prueba locales (dev-token)
DEV_AUTH=true

# (Opcional) Producción con Microsoft Entra ID
# JWKS_URL="https://<tenant>.ciamlogin.com/<tenant_id>/discovery/v2.0/keys"
# JWT_ISSUER="https://<tenant>.ciamlogin.com/<tenant_id>/v2.0"
# JWT_AUDIENCE="<client_id>"


# ==============================================================================
# 2. ANALYSIS WORKER (worker/.env)
# ==============================================================================
# Conexiones de datos compartidas
SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:sql-voxready-st.database.windows.net,1433;Database=sqldb-voxready;Uid=<db_user>;Pwd=<db_password>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"
STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<storage_account_name>;AccountKey=<storage_key>;EndpointSuffix=core.windows.net"
STORAGE_CONTAINER_NAME="recordings"
SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://<servicebus_namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<key>"
SERVICE_BUS_QUEUE_NAME="analysis-queue"

# Microservicio de Visión MediaPipe (Azure Container Apps)
VISION_SERVICE_URL="https://ca-vision-service.<domain>.westus.azurecontainerapps.io"

# Modelos de Lenguaje e Inteligencia Artificial (NVIDIA NIM / Cloud)
NVIDIA_API_KEY="nvapi-<your_nvidia_key>"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
LLM_MODEL_NAME="meta/llama-3.2-11b-vision-instruct"
LLM_TIMEOUT="120.0"

# Opciones de logging y Key Vault
LOG_LEVEL="INFO"
KEY_VAULT_URL="https://<keyvault_name>.vault.azure.net/"


# ==============================================================================
# 3. FRONTEND NEXT.JS (frontend/.env.local)
# ==============================================================================
# URL pública de ca-backend-api
NEXT_PUBLIC_API_URL="https://ca-backend-api.<domain>.westus.azurecontainerapps.io/v1"

# Identificadores de Microsoft Entra ID (Auth)
NEXT_PUBLIC_AZURE_CLIENT_ID="<client_id>"
NEXT_PUBLIC_AZURE_TENANT_ID="<tenant_id>"
NEXT_PUBLIC_REDIRECT_URI="http://localhost:3000"

# Permite bypass de login con dev-token para desarrollo ágil
NEXT_PUBLIC_DEV_AUTH="true"


# ==============================================================================
# 4. LABORATORIO / TESTING (lab-worker/.env)
# ==============================================================================
# Pruebas directas de NVIDIA Riva ASR (reconocimiento de voz)
NVIDIA_API_KEY="nvapi-<your_nvidia_key>"
NVIDIA_RIVA_SERVER="grpc.nvcf.nvidia.com:443"
NVIDIA_FUNCTION_ID="71203149-d3b7-4460-8231-1be2543a1fca"
NVIDIA_LANGUAGE_CODE="es-US"
