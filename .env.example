# Configuración compartida del monorepo: copiar a .env en la raíz.
# Los valores Azure concretos ya se guardan en .env; este archivo solo muestra las claves.

# Microsoft Entra External ID (CIAM) - frontend
NEXT_PUBLIC_AZURE_TENANT_ID=your-tenant-id
NEXT_PUBLIC_AZURE_CLIENT_ID=your-client-id
NEXT_PUBLIC_AZURE_AUTHORITY=https://yourtenant.ciamlogin.com/your-tenant-id
NEXT_PUBLIC_AZURE_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_AZURE_API_SCOPE=api://your-api-client-id/access_as_user
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

# Modo de autenticación: 'azure' por defecto o 'local' para tokens de prueba
# NEXT_PUBLIC_AUTH_MODE=azure

# Backend y Azure SQL
ENVIRONMENT=development
DATABASE_URL=mssql+aioodbc://user:password@server.database.windows.net:1433/database?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
DEV_AUTH=false
DEV_AUTH_SECRET=replace-with-random-local-development-secret
DEV_TOKEN_TTL_HOURS=8
CORS_ORIGINS=http://localhost:3000
JWKS_URL=https://yourtenant.ciamlogin.com/your-tenant-id/discovery/v2.0/keys
JWT_ISSUER=https://yourtenant.ciamlogin.com/your-tenant-id/v2.0
JWT_AUDIENCE=your-api-client-id

# Servicios existentes
STORAGE_DIR=./storage
UPLOAD_SIGNING_SECRET=replace-with-random-signing-secret
UPLOAD_URL_TTL_MINUTES=15
READ_URL_TTL_MINUTES=60
MAX_UPLOAD_SIZE_BYTES=524288000
WEBHOOK_ENDPOINTS=
WEBHOOK_SECRET=replace-with-random-webhook-secret
WEBHOOK_MAX_RETRIES=3
ANALYSIS_STEP_SECONDS=0.5
ANALYSIS_ESTIMATED_SECONDS=30
RETENTION_JOB_INTERVAL_SECONDS=86400
ENABLE_ANALYSIS_WORKER=true
ENABLE_RETENTION_JOB=true
LABELING_RANDOM_SAMPLE_RATE=10

# --- CORS (Backend) ---
CORS_ORIGINS=http://localhost:3000
