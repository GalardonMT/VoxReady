# Configuración compartida del monorepo: copiar a .env en la raíz.
# Los valores Azure concretos ya se guardan en .env; este archivo solo muestra las claves.

# Microsoft Entra External ID (CIAM) - frontend
NEXT_PUBLIC_AZURE_TENANT_ID=your-tenant-id
NEXT_PUBLIC_AZURE_CLIENT_ID=your-client-id
NEXT_PUBLIC_AZURE_AUTHORITY=https://yourtenant.ciamlogin.com/your-tenant-id
NEXT_PUBLIC_AZURE_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_AZURE_API_SCOPE=api://your-api-client-id/access_as_user
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

# URLs públicas de las imágenes Docker (se fijan al construir el frontend).
VOXREADY_DOCKER_API_URL=http://localhost:8000/v1
VOXREADY_DOCKER_REDIRECT_URI=http://localhost:3000
VOXREADY_API_PORT=8000
VOXREADY_WEB_PORT=3000
VOXREADY_IMAGE_TAG=latest

# Modo de autenticación: 'azure' por defecto o 'local' para tokens de prueba
NEXT_PUBLIC_AUTH_MODE=azure

# Backend y Azure SQL
ENVIRONMENT=development
ENABLE_API_DOCS=false
SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-server.database.windows.net,1433;Database=sqldb-voxready;Uid=your-user;Pwd=your-password;Encrypt=yes;TrustServerCertificate=no;"
DATABASE_URL=mssql+aioodbc://user:password@server.database.windows.net:1433/database?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
DEV_AUTH=false
NEXT_PUBLIC_DEV_AUTH=false
DEV_AUTH_SECRET=replace-with-random-local-development-secret
DEV_USERS_JSON=[]
DEV_TOKEN_TTL_HOURS=8
CORS_ORIGINS=http://localhost:3000
JWKS_URL=https://yourtenant.ciamlogin.com/your-tenant-id/discovery/v2.0/keys
JWT_ISSUER=https://yourtenant.ciamlogin.com/your-tenant-id/v2.0
JWT_AUDIENCE=your-api-client-id

# Servicios existentes
STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=your-storage-account;AccountKey=your-storage-key;EndpointSuffix=core.windows.net"
STORAGE_CONTAINER_NAME=recordings
STORAGE_RECORDING_PREFIX=recordings
STORAGE_MICROLESSON_PREFIX=microlessons
STORAGE_REPORT_CONTAINER_NAME=reports
STORAGE_REPORT_PREFIX=
MICROLESSON_VIDEO_MAX_BYTES=262144000
WORKER_INTERNAL_URL=http://worker:8000/analyze
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
VISION_SERVICE_URL=http://vision:8000
VISION_SERVICE_TOKEN=replace-with-at-least-32-random-characters
VISION_MAX_FRAME_BYTES=5242880
VISION_MAX_BATCH_FRAMES=20
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL_NAME=replace-with-your-approved-model-name
LLM_FALLBACK_MODEL_NAME=
NVIDIA_RIVA_SERVER=replace-with-your-riva-server
NVIDIA_FUNCTION_ID=replace-with-your-riva-function-id
NVIDIA_LANGUAGE_CODE=es-US
VISION_FACE_MODEL_PATH=/opt/mediapipe-models/face_landmarker.task
VISION_POSE_MODEL_PATH=/opt/mediapipe-models/pose_landmarker_lite.task
STORAGE_DIR=./storage
UPLOAD_SIGNING_SECRET=replace-with-random-signing-secret
UPLOAD_URL_TTL_MINUTES=15
READ_URL_TTL_MINUTES=60
MAX_UPLOAD_SIZE_BYTES=524288000
WEBHOOK_ENDPOINTS=
WEBHOOK_SECRET=replace-with-random-webhook-secret
WEBHOOK_MAX_RETRIES=3
ANALYSIS_STEP_SECONDS=0.5
ANALYSIS_ESTIMATED_SECONDS=30
RETENTION_JOB_INTERVAL_SECONDS=86400
ENABLE_ANALYSIS_WORKER=true
ENABLE_RETENTION_JOB=true
LABELING_RANDOM_SAMPLE_RATE=10
