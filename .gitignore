# ==============================================================================
# VoxReady - Global .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración local y secretos: mantener fuera del historial
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.pfx
secrets/
Indicaciones/
*ENV*.md
*env*.md
ENV´S.md

# ------------------------------------------------------------------------------
# 2. Node.js & Next.js (Frontend)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/
.eslintcache
*.tsbuildinfo
next-env.d.ts

# Logs de gestores de paquetes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Python (Backend, Worker, Vision, Lab)
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Entornos virtuales
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing, Cobertura y Linters
.pytest_cache/
**/.pytest_cache/
pytest-cache-files-*/
**/pytest-cache-files-*/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
*.egg-info/
*.egg

# ------------------------------------------------------------------------------
# 4. Multimedia y Archivos Temporales de Grabación
# ------------------------------------------------------------------------------
# Videos y Audios pesados
*.wav
*.mp3
*.ogg
*.opus
*.webm
*.mp4
*.mkv
*.avi

# Carpetas de procesamiento multimedia
outputs/
**/outputs/
grabaciones/
**/grabaciones/
frames/
**/frames/
*_frames/

# Reportes temporales generados
*_report.json
reporte_*.json

# Modelos pesados de MediaPipe y Vision
*.task
models/
**/models/
python-clients/
**/python-clients/

# ------------------------------------------------------------------------------
# 5. Sistema Operativo y Editores
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs y editores
.idea/
*.swp
*.swo
*~
*.bak

# Archivos de depuración y temporales locales
*.log
-
scratch/

# Datos y configuración exclusiva de pruebas locales
*.db
*.sqlite
*.sqlite3
backend/storage/
backend/local_scenario_test/
worker/local.settings.json

# Material local histórico: se conserva en disco, fuera del repositorio
docker-compose.local.yml
docker-compose.scenario-test.yml
backend/Dockerfile.local
frontend/Dockerfile.local
LOCAL_DOCKER.md
lab-worker/
discurso_prueba_entrevista.txt
