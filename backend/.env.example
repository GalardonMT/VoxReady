# --- Base de datos -------------------------------------------------------
# Producción (docker-compose): postgresql+asyncpg://voxready:voxready@db:5432/voxready
# Local sin Docker:            sqlite+aiosqlite:///./voxready.db
DATABASE_URL=sqlite+aiosqlite:///./voxready.db

# --- Autenticación -------------------------------------------------------
# Modo dev: firma HS256 local + endpoint POST /v1/dev/token (NO usar en prod).
DEV_AUTH=true
DEV_AUTH_SECRET=cambia-este-secreto-dev
DEV_TOKEN_TTL_HOURS=8
# Validación RS256 lista para Azure AD B2C (complementa al modo dev):
# JWKS_URL=https://<tenant>.b2clogin.com/<tenant>.onmicrosoft.com/<policy>/discovery/v2.0/keys
# JWT_ISSUER=https://<tenant>.b2clogin.com/<uuid>/v2.0/
# JWT_AUDIENCE=<client-id-de-la-api>

# --- Storage de grabaciones ----------------------------------------------
STORAGE_DIR=./storage
UPLOAD_SIGNING_SECRET=cambia-este-secreto-uploads
UPLOAD_URL_TTL_MINUTES=15
READ_URL_TTL_MINUTES=60
MAX_UPLOAD_SIZE_BYTES=524288000

# --- Webhooks salientes ---------------------------------------------------
# Lista separada por comas; vacío = sin envío.
WEBHOOK_ENDPOINTS=
WEBHOOK_SECRET=cambia-este-secreto-webhooks
WEBHOOK_MAX_RETRIES=3

# --- Procesamiento en segundo plano ---------------------------------------
ANALYSIS_STEP_SECONDS=0.5
ANALYSIS_ESTIMATED_SECONDS=30
RETENTION_JOB_INTERVAL_SECONDS=86400
ENABLE_ANALYSIS_WORKER=true
ENABLE_RETENTION_JOB=true
LABELING_RANDOM_SAMPLE_RATE=10
