{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=false",
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "STORAGE_CONNECTION_STRING": "@Microsoft.KeyVault(SecretUri=https://<keyvault-name>.vault.azure.net/secrets/storage-connection/)",
    "STORAGE_CONTAINER_NAME": "recordings",
    "STORAGE_REPORT_CONTAINER_NAME": "reports",
    "STORAGE_REPORT_PREFIX": "",
    "DATABASE_URL": "@Microsoft.KeyVault(SecretUri=https://<keyvault-name>.vault.azure.net/secrets/database-url/)",
    "NVIDIA_API_KEY": "@Microsoft.KeyVault(SecretUri=https://<keyvault-name>.vault.azure.net/secrets/nvidia-api-key/)",
    "NVIDIA_BASE_URL": "https://integrate.api.nvidia.com/v1",
    "LLM_MODEL_NAME": "<replace-with-approved-model-name>",
    "VISION_SERVICE_URL": "https://your-vision-host.example.invalid",
    "VISION_SERVICE_TOKEN": "<replace-with-at-least-32-random-characters>",
    "INTERNAL_SERVICE_TOKEN": "<replace-with-at-least-32-random-characters>",
    "NVIDIA_RIVA_SERVER": "<replace-with-riva-server>",
    "NVIDIA_FUNCTION_ID": "<replace-with-riva-function-id>",
    "NVIDIA_LANGUAGE_CODE": "es-US",
    "LOG_LEVEL": "INFO"
  }
}
