# Perfil separado para validar el registro de clientes desde Docker.
# Copiar como .env.client-registration.local (ignorado por Git) y reemplazar
# todos los valores ficticios por recursos NO productivos. El proyecto solo
# admite Azure SQL; no sustituirlo por SQLite ni por un contenedor SQL local.

SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-isolated-test-server.database.windows.net,1433;Database=voxready-client-registration-test;Uid=your-test-user;Pwd=your-test-password;Encrypt=yes;TrustServerCertificate=no;"

NEXT_PUBLIC_AZURE_TENANT_ID=test-tenant-id
NEXT_PUBLIC_AZURE_CLIENT_ID=test-client-id
NEXT_PUBLIC_AZURE_AUTHORITY=https://your-test-tenant.ciamlogin.com/test-tenant-id
NEXT_PUBLIC_AZURE_API_SCOPE=api://test-client-id/access_as_user
VOXREADY_DOCKER_API_URL=http://localhost:8000/v1
VOXREADY_DOCKER_REDIRECT_URI=http://localhost:3000
VOXREADY_API_PORT=8000
VOXREADY_WEB_PORT=3000

JWKS_URL=https://your-test-tenant.ciamlogin.com/test-tenant-id/discovery/v2.0/keys
JWT_ISSUER=https://your-test-tenant.ciamlogin.com/test-tenant-id/v2.0
JWT_AUDIENCE=test-client-id
CORS_ORIGINS=http://localhost:3000

DEV_AUTH_TEST_EMAIL=master.preassigned@example.invalid
STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=your-test-storage;AccountKey=your-test-key;EndpointSuffix=core.windows.net"
STORAGE_CONTAINER_NAME=recordings
SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://your-test-namespace.servicebus.windows.net/;SharedAccessKeyName=your-test-policy;SharedAccessKey=your-test-key"
SERVICE_BUS_QUEUE_NAME=analysis-queue
